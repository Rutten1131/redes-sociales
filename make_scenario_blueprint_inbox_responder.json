{
    "name": "RRSS - Responder Comentarios y DMs (Meta e IG)",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": 2771003,
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 600
                },
                "restore": {
                    "parameters": {
                        "hook": {
                            "data": {
                                "editable": "true"
                            },
                            "label": "My gateway-webhook webhook"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "hook",
                        "type": "hook:gateway-webhook",
                        "label": "Webhook",
                        "required": true
                    },
                    {
                        "name": "maxResults",
                        "type": "number",
                        "label": "Maximum number of results"
                    }
                ]
            }
        },
        {
            "id": 2,
            "module": "builtin:BasicRouter",
            "version": 1,
            "mapper": null,
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 600
                }
            },
            "routes": [
                {
                    "flow": [
                        {
                            "id": 10,
                            "module": "facebook-pages:CreateComment",
                            "version": 6,
                            "parameters": {
                                "__IMTCONN__": 10746705
                            },
                            "filter": {
                                "name": "FB Responder Comentario",
                                "conditions": [
                                    [
                                        {
                                            "a": "{{1.platform}}",
                                            "b": "FACEBOOK",
                                            "o": "text:equal"
                                        },
                                        {
                                            "a": "{{1.type}}",
                                            "b": "COMMENT",
                                            "o": "text:equal"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {
                                "objectId": "{{1.externalId}}",
                                "message": "{{1.replyMessage}}"
                            },
                            "metadata": {
                                "designer": {
                                    "x": 600,
                                    "y": 0,
                                    "name": "Responder Comentario FB"
                                },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": {
                                            "data": {
                                                "scoped": "true",
                                                "connection": "facebook"
                                            },
                                            "label": "My Facebook connection (Objetivo Cesar Reyes)"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "id": 11,
                            "module": "gateway:WebhookRespond",
                            "version": 1,
                            "parameters": {},
                            "mapper": {
                                "body": "{\"success\":true}",
                                "status": 200,
                                "headers": []
                            },
                            "metadata": {
                                "designer": {
                                    "x": 900,
                                    "y": 0
                                }
                            }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 20,
                            "module": "facebook-messenger:sendMessage",
                            "version": 2,
                            "filter": {
                                "name": "FB Responder Mensaje DM",
                                "conditions": [
                                    [
                                        {
                                            "a": "{{1.platform}}",
                                            "b": "FACEBOOK",
                                            "o": "text:equal"
                                        },
                                        {
                                            "a": "{{1.type}}",
                                            "b": "DM",
                                            "o": "text:equal"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {
                                "recipient": "{{1.fromExternalId}}",
                                "text": "{{1.replyMessage}}"
                            },
                            "metadata": {
                                "designer": {
                                    "x": 600,
                                    "y": 300,
                                    "name": "Responder DM FB"
                                }
                            }
                        },
                        {
                            "id": 21,
                            "module": "gateway:WebhookRespond",
                            "version": 1,
                            "parameters": {},
                            "mapper": {
                                "body": "{\"success\":true}",
                                "status": 200,
                                "headers": []
                            },
                            "metadata": {
                                "designer": {
                                    "x": 900,
                                    "y": 300
                                }
                            }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 30,
                            "module": "instagram-business:CreateComment",
                            "version": 1,
                            "parameters": {
                                "__IMTCONN__": 10746705
                            },
                            "filter": {
                                "name": "IG Responder Comentario",
                                "conditions": [
                                    [
                                        {
                                            "a": "{{1.platform}}",
                                            "b": "INSTAGRAM",
                                            "o": "text:equal"
                                        },
                                        {
                                            "a": "{{1.type}}",
                                            "b": "COMMENT",
                                            "o": "text:equal"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {
                                "commentId": "{{1.externalId}}",
                                "message": "{{1.replyMessage}}"
                            },
                            "metadata": {
                                "designer": {
                                    "x": 600,
                                    "y": 600,
                                    "name": "Responder Comentario IG"
                                },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": {
                                            "data": {
                                                "scoped": "true",
                                                "connection": "facebook"
                                            },
                                            "label": "My Facebook connection (Objetivo Cesar Reyes)"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "id": 31,
                            "module": "gateway:WebhookRespond",
                            "version": 1,
                            "parameters": {},
                            "mapper": {
                                "body": "{\"success\":true}",
                                "status": 200,
                                "headers": []
                            },
                            "metadata": {
                                "designer": {
                                    "x": 900,
                                    "y": 600
                                }
                            }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 40,
                            "module": "facebook-messenger:sendMessage",
                            "version": 2,
                            "filter": {
                                "name": "IG Responder Mensaje DM",
                                "conditions": [
                                    [
                                        {
                                            "a": "{{1.platform}}",
                                            "b": "INSTAGRAM",
                                            "o": "text:equal"
                                        },
                                        {
                                            "a": "{{1.type}}",
                                            "b": "DM",
                                            "o": "text:equal"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {
                                "recipient": "{{1.fromExternalId}}",
                                "text": "{{1.replyMessage}}"
                            },
                            "metadata": {
                                "designer": {
                                    "x": 600,
                                    "y": 900,
                                    "name": "Responder DM IG"
                                }
                            }
                        },
                        {
                            "id": 41,
                            "module": "gateway:WebhookRespond",
                            "version": 1,
                            "parameters": {},
                            "mapper": {
                                "body": "{\"success\":true}",
                                "status": 200,
                                "headers": []
                            },
                            "metadata": {
                                "designer": {
                                    "x": 900,
                                    "y": 900
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "confidential": false,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "us2.make.com"
    }
}
