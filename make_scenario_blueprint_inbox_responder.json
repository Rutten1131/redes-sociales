{
    "name": "RRSS - Responder Comentarios y DMs (Meta e IG)",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 600
                },
                "restore": {
                    "parameters": {
                        "hook": {
                            "data": {
                                "editable": "true"
                            },
                            "label": "Webhook-Inbox-Responder"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "hook",
                        "type": "hook:gateway-webhook",
                        "label": "Webhook",
                        "required": true
                    },
                    {
                        "name": "maxResults",
                        "type": "number",
                        "label": "Maximum number of results"
                    }
                ]
            }
        },
        {
            "id": 2,
            "module": "builtin:BasicRouter",
            "version": 1,
            "mapper": null,
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 600
                }
            },
            "routes": [
                {
                    "flow": [
                        {
                            "id": 10,
                            "module": "http:MakeRequest",
                            "version": 4,
                            "parameters": {
                                "tlsType": "",
                                "proxyKeychain": "",
                                "authenticationType": "noAuth"
                            },
                            "filter": {
                                "name": "FB Comentario",
                                "conditions": [
                                    [
                                        {
                                            "a": "{{1.platform}}",
                                            "b": "FACEBOOK",
                                            "o": "text:equal"
                                        },
                                        {
                                            "a": "{{1.type}}",
                                            "b": "COMMENT",
                                            "o": "text:equal"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {
                                "url": "https://graph.facebook.com/v21.0/{{1.externalId}}/comments",
                                "method": "post",
                                "headers": [
                                    {
                                        "name": "Content-Type",
                                        "value": "application/x-www-form-urlencoded"
                                    }
                                ],
                                "bodyType": "raw",
                                "contentType": "custom",
                                "body": "message={{1.replyMessage}}&access_token={{1.accessToken}}",
                                "shareCookies": false,
                                "parseResponse": true,
                                "allowRedirects": true,
                                "stopOnHttpError": true,
                                "requestCompressedContent": true
                            },
                            "metadata": {
                                "designer": {
                                    "x": 600,
                                    "y": 200,
                                    "name": "Responder Comentario FB"
                                }
                            }
                        },
                        {
                            "id": 11,
                            "module": "gateway:WebhookRespond",
                            "version": 1,
                            "parameters": {},
                            "mapper": {
                                "body": "{\"success\": true}",
                                "status": "200",
                                "headers": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application/json"
                                    }
                                ]
                            },
                            "metadata": {
                                "designer": {
                                    "x": 900,
                                    "y": 200
                                }
                            }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 20,
                            "module": "http:MakeRequest",
                            "version": 4,
                            "parameters": {
                                "tlsType": "",
                                "proxyKeychain": "",
                                "authenticationType": "noAuth"
                            },
                            "filter": {
                                "name": "FB DM",
                                "conditions": [
                                    [
                                        {
                                            "a": "{{1.platform}}",
                                            "b": "FACEBOOK",
                                            "o": "text:equal"
                                        },
                                        {
                                            "a": "{{1.type}}",
                                            "b": "DM",
                                            "o": "text:equal"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {
                                "url": "https://graph.facebook.com/v21.0/me/messages?access_token={{1.accessToken}}",
                                "method": "post",
                                "headers": [
                                    {
                                        "name": "Content-Type",
                                        "value": "application/json"
                                    }
                                ],
                                "bodyType": "raw",
                                "contentType": "json",
                                "body": "{\"recipient\":{\"id\":\"{{1.fromExternalId}}\"},\"message\":{\"text\":\"{{1.replyMessage}}\"}}",
                                "shareCookies": false,
                                "parseResponse": true,
                                "allowRedirects": true,
                                "stopOnHttpError": true,
                                "requestCompressedContent": true
                            },
                            "metadata": {
                                "designer": {
                                    "x": 600,
                                    "y": 450,
                                    "name": "Responder DM FB"
                                }
                            }
                        },
                        {
                            "id": 21,
                            "module": "gateway:WebhookRespond",
                            "version": 1,
                            "parameters": {},
                            "mapper": {
                                "body": "{\"success\": true}",
                                "status": "200",
                                "headers": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application/json"
                                    }
                                ]
                            },
                            "metadata": {
                                "designer": {
                                    "x": 900,
                                    "y": 450
                                }
                            }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 30,
                            "module": "http:MakeRequest",
                            "version": 4,
                            "parameters": {
                                "tlsType": "",
                                "proxyKeychain": "",
                                "authenticationType": "noAuth"
                            },
                            "filter": {
                                "name": "IG Comentario",
                                "conditions": [
                                    [
                                        {
                                            "a": "{{1.platform}}",
                                            "b": "INSTAGRAM",
                                            "o": "text:equal"
                                        },
                                        {
                                            "a": "{{1.type}}",
                                            "b": "COMMENT",
                                            "o": "text:equal"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {
                                "url": "https://graph.facebook.com/v21.0/{{1.externalId}}/replies",
                                "method": "post",
                                "headers": [
                                    {
                                        "name": "Content-Type",
                                        "value": "application/x-www-form-urlencoded"
                                    }
                                ],
                                "bodyType": "raw",
                                "contentType": "custom",
                                "body": "message={{1.replyMessage}}&access_token={{1.accessToken}}",
                                "shareCookies": false,
                                "parseResponse": true,
                                "allowRedirects": true,
                                "stopOnHttpError": true,
                                "requestCompressedContent": true
                            },
                            "metadata": {
                                "designer": {
                                    "x": 600,
                                    "y": 700,
                                    "name": "Responder Comentario IG"
                                }
                            }
                        },
                        {
                            "id": 31,
                            "module": "gateway:WebhookRespond",
                            "version": 1,
                            "parameters": {},
                            "mapper": {
                                "body": "{\"success\": true}",
                                "status": "200",
                                "headers": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application/json"
                                    }
                                ]
                            },
                            "metadata": {
                                "designer": {
                                    "x": 900,
                                    "y": 700
                                }
                            }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 40,
                            "module": "http:MakeRequest",
                            "version": 4,
                            "parameters": {
                                "tlsType": "",
                                "proxyKeychain": "",
                                "authenticationType": "noAuth"
                            },
                            "filter": {
                                "name": "IG DM",
                                "conditions": [
                                    [
                                        {
                                            "a": "{{1.platform}}",
                                            "b": "INSTAGRAM",
                                            "o": "text:equal"
                                        },
                                        {
                                            "a": "{{1.type}}",
                                            "b": "DM",
                                            "o": "text:equal"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {
                                "url": "https://graph.facebook.com/v21.0/me/messages?access_token={{1.accessToken}}",
                                "method": "post",
                                "headers": [
                                    {
                                        "name": "Content-Type",
                                        "value": "application/json"
                                    }
                                ],
                                "bodyType": "raw",
                                "contentType": "json",
                                "body": "{\"recipient\":{\"id\":\"{{1.fromExternalId}}\"},\"message\":{\"text\":\"{{1.replyMessage}}\"}}",
                                "shareCookies": false,
                                "parseResponse": true,
                                "allowRedirects": true,
                                "stopOnHttpError": true,
                                "requestCompressedContent": true
                            },
                            "metadata": {
                                "designer": {
                                    "x": 600,
                                    "y": 950,
                                    "name": "Responder DM IG"
                                }
                            }
                        },
                        {
                            "id": 41,
                            "module": "gateway:WebhookRespond",
                            "version": 1,
                            "parameters": {},
                            "mapper": {
                                "body": "{\"success\": true}",
                                "status": "200",
                                "headers": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application/json"
                                    }
                                ]
                            },
                            "metadata": {
                                "designer": {
                                    "x": 900,
                                    "y": 950
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "confidential": false,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "us2.make.com"
    }
}
